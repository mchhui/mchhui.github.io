      <title>重心坐标的数学原理、计算方法与应用综述</title>
      <link>http://localhost:1313/post/%E9%87%8D%E5%BF%83%E5%9D%90%E6%A0%87%E7%9A%84%E6%95%B0%E5%AD%A6%E5%8E%9F%E7%90%86%E8%AE%A1%E7%AE%97%E6%96%B9%E6%B3%95%E4%B8%8E%E5%BA%94%E7%94%A8%E7%BB%BC%E8%BF%B0/</link>
